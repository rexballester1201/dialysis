<?php

declare(strict_types=1);

use App\Domain\Billing\Http\BenefitController;
use App\Domain\Billing\Http\ClaimController;
use App\Domain\Billing\Http\InvoiceController;
use App\Domain\Clinical\Http\LabController;
use App\Domain\Clinical\Http\PrescriptionController;
use App\Domain\Clinical\Http\SessionController;
use App\Domain\Core\Http\AuthController;
use App\Domain\Core\Http\PatientController;
use App\Domain\Ops\Http\BoardController;
use App\Domain\Ops\Http\DialyzerController;
use App\Domain\Ops\Http\MachineController;
use App\Domain\Ops\Http\ReportController;
use App\Domain\Ops\Http\StandingScheduleController;
use App\Domain\Ops\Http\StockController;
use App\Domain\Ops\Http\WaterLogController;
use App\Domain\Sync\Http\SyncController;
use Illuminate\Support\Facades\Route;

/*
|--------------------------------------------------------------------------
| API v1
|--------------------------------------------------------------------------
| Auth: Laravel Sanctum. The bedside PWA holds a device-scoped personal
| access token with the `bedside` ability and a short TTL; desktop clients
| use the same token flow with broader abilities. A nurse re-authenticates
| within a shift by clinical PIN, which re-issues the token without a full
| password round trip.
*/

Route::prefix('v1')->group(function (): void {
    Route::post('auth/login',      [AuthController::class, 'login'])->middleware('throttle:5,1');
    Route::post('auth/pin-unlock', [AuthController::class, 'pinUnlock'])->middleware('throttle:10,1');

    Route::middleware(['auth:sanctum', 'log.access'])->group(function (): void {
        Route::post('auth/logout', [AuthController::class, 'logout']);

        // ---- offline sync (bedside PWA) --------------------------------
        Route::get('sync/bootstrap', [SyncController::class, 'bootstrap'])->name('sync.bootstrap');
        Route::post('sync',          [SyncController::class, 'store'])->name('sync.store')
             ->middleware('throttle:60,1');

        // ---- patients ---------------------------------------------------
        Route::apiResource('patients', PatientController::class);
        Route::get('patients/{patient}/timeline',  [PatientController::class, 'timeline'])->name('patients.timeline');
        Route::get('patients/{patient}/labs',      [LabController::class, 'index'])->name('patients.labs');
        Route::post('patients/{patient}/prescriptions', [PrescriptionController::class, 'store'])
             ->name('patients.prescriptions.store')->can('prescribe', 'patient');

        // ---- scheduling --------------------------------------------------
        Route::get('board',            [BoardController::class, 'index'])->name('board');
        Route::get('board/available-stations', [BoardController::class, 'availableStations']);
        Route::apiResource('schedules', StandingScheduleController::class);

        // ---- the session lifecycle ---------------------------------------
        Route::apiResource('sessions', SessionController::class);
        Route::post('sessions/{session}/vitals',     [SessionController::class, 'appendVital'])->can('chart', 'session');
        Route::post('sessions/{session}/events',     [SessionController::class, 'appendEvent'])->can('chart', 'session');
        Route::post('sessions/{session}/medications', [SessionController::class, 'administer'])->can('chart', 'session');
        Route::post('sessions/{session}/sign/nurse',     [SessionController::class, 'signNurse'])->can('signAsNurse', 'session');
        Route::post('sessions/{session}/sign/physician', [SessionController::class, 'signPhysician'])->can('signAsPhysician', 'session');
        Route::post('sessions/{session}/amend',      [SessionController::class, 'amend'])->can('amend', 'session');

        // ---- ops ----------------------------------------------------------
        Route::apiResource('machines', MachineController::class);
        Route::apiResource('water-logs', WaterLogController::class)->only(['index', 'store']);
        Route::apiResource('stock', StockController::class);
        Route::post('dialyzers/{dialyzer}/reprocess', [DialyzerController::class, 'reprocess']);

        // ---- billing --------------------------------------------------------
        Route::apiResource('invoices', InvoiceController::class);
        Route::apiResource('claims',   ClaimController::class);
        Route::post('claims/generate', [ClaimController::class, 'generate'])->name('claims.generate');
        Route::get('benefits/{patient}', [BenefitController::class, 'show'])->name('benefits.show');

        // ---- reports (read the views) ------------------------------------
        Route::get('reports/quality',          [ReportController::class, 'quality']);
        Route::get('reports/cohort-violations', [ReportController::class, 'cohortViolations']);
        Route::get('reports/water-exceptions',  [ReportController::class, 'waterExceptions']);
        Route::get('reports/utilisation',       [ReportController::class, 'utilisation']);
    });
});
