    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web": "^0.0.354",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
